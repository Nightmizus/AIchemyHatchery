DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash
# dsh 原生 DeepSeek 适配器地址；由后端转换为 dsh 的启动环境变量
HATCHERY_DEEPSEEK_BASE_URL=https://lightingtheword.com/v1
# 原生联网搜索调用 Anthropic Messages 的 web_search 工具；默认沿用上面的网关和 DeepSeek 模型/Key。
# 网关必须支持 /messages 及原生搜索结果；搜索本身会产生模型调用。
# 以下可单独覆盖搜索入口（不含 /messages）、模型和 Key；网页读取 web_fetch 无需模型 Key。
# HATCHERY_DEEPSEEK_SEARCH_BASE_URL=https://lightingtheword.com/v1
# HATCHERY_DEEPSEEK_SEARCH_MODEL=DeepSeek-V4.1-Flash
# HATCHERY_DEEPSEEK_SEARCH_API_KEY=
# 运行时尚未返回上下文容量时的估算上限（tokens）
HATCHERY_AI_CONTEXT_WINDOW=1000000
# 跨账号并发数，1–4，默认 2；同一账号仍串行。运行中修改此项自动生效，不中断已有任务。
HATCHERY_AI_MAX_PARALLEL=2
# 无有效会话进展时自动以新运行时续作；保留当前文件，最多恢复 1 次，0 可关闭（硬上限 2）。
HATCHERY_AI_STALL_SECONDS=180
HATCHERY_AI_AUTO_RECOVERIES=1
DEEPSEEK_REASONING_EFFORT=high
# 任务不设总执行时长上限；旧 DEEPSEEK_HARNESS_TIMEOUT_SECONDS 配置不再生效。
# 持续无有效进展仍由 HATCHERY_AI_STALL_SECONDS 检测并尝试安全恢复。
DEEPSEEK_MAX_TOKENS=32768
# 可选：覆盖本地 Harness 运行时路径
# DEEPSEEK_HARNESS_BIN=C:\path\to\deepseek-harness-sdk-runtime-win-x64.exe

# AI 调整使用的 LLM：kimi / glm / deepseek；留空时按已配置的 Key 自动选择（有 KIMI_API_KEY 用 Kimi，其次 GLM_API_KEY 用 GLM）
MIAODA_LLM=deepseek
# Kimi（K3）——sk-kimi- 开头的 Key 自动走 coding 端点，其他 Key 走 api.moonshot.cn
KIMI_API_KEY=
KIMI_MODEL=k3
KIMI_REASONING_EFFORT=high
# 可选：覆盖 Kimi 端点
# KIMI_BASE_URL=

# 智谱 GLM（国内 open.bigmodel.cn）——Key 形如 <id>.<secret>；模型可选 glm-5.3 / glm-5.3-flash / glm-4.7
GLM_API_KEY=
GLM_MODEL=glm-5.3
GLM_REASONING_EFFORT=high
# 可选：覆盖 GLM 端点（默认 https://open.bigmodel.cn/api/paas/v4；Coding Plan 订阅用 https://open.bigmodel.cn/api/coding/paas/v4）
# GLM_BASE_URL=

# 默认仅允许本机访问；对外直连可改为 0.0.0.0，生产环境更建议放在反向代理后
ALCHEMY_HATCHERY_HOST=127.0.0.1
ALCHEMY_HATCHERY_PORT=4173
# 反向代理已启用 HTTPS 时设为 true；纯 HTTP 本地开发保持 false
ALCHEMY_HATCHERY_SECURE_COOKIES=false

# 管理员不得写入此文件。首次部署请在服务器终端运行：
# python server.py create-admin

# 默认使用当前入口的 /pages/<slug>/；仅在 DNS 和 HTTPS 就绪后启用独立子域名。
ALCHEMY_HATCHERY_SITE_SUBDOMAINS_ENABLED=0
# 启用独立域名时，后端通过反向代理的实际 TLS 握手确认域名已就绪。
# 原生 nginx 部署使用默认值；容器部署需填写容器可达的 TLS 代理地址。
# ALCHEMY_HATCHERY_TLS_PROBE_HOST=127.0.0.1
# ALCHEMY_HATCHERY_TLS_PROBE_PORT=443
# 动态服务：默认关闭；填写账号 ID 的 SHA-256（逗号分隔），或 * 对所有现有及新账号开放。
# 需安装原生 Linux 的 ops/hatchery-site-runtime.service。全账号模式还需 root 所有的
# /etc/hatchery-sites/policy.json 设置 {"allowAllAccounts":true}；broker 独立核验数据库中的
# 账号与网站归属后，自动写入 allowed-sites.json 的目录 inode 绑定。不会启动未请求的后台，
# 不会赋予宿主 shell、平台管理权限或访问其他网站的能力。
HATCHERY_DYNAMIC_SITE_KEYS=
