[Unit]
Description=Broker for isolated per-website runtimes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/hatchery-site-runtime
Restart=on-failure
RestartSec=3
RuntimeDirectory=hatchery-sites
RuntimeDirectoryMode=0750
UMask=0077
MemoryMax=128M
TasksMax=96

[Install]
WantedBy=multi-user.target
